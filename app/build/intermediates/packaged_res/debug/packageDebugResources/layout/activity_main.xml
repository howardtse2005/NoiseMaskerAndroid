<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Noise Masker Controls"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: stopped"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/sourceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Input source: -"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/inputLevelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Input p/r/d/n/v: 0.000 / 0.000 / 0.000 / 0.00 / 0.000"
            android:textSize="14sp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Start" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop" />

        <TextView
            android:id="@+id/preampLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Digital Preamp: 120" />

        <SeekBar
            android:id="@+id/preampSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="2000"
            android:progress="120" />

        <TextView
            android:id="@+id/baseVolLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Base Vol: 0.04" />

        <SeekBar
            android:id="@+id/baseVolSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="4" />

        <TextView
            android:id="@+id/maxVolLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Max Vol: 0.25" />

        <SeekBar
            android:id="@+id/maxVolSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="25" />

        <TextView
            android:id="@+id/attackLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attack Swell: 0.20" />

        <SeekBar
            android:id="@+id/attackSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="20" />

        <TextView
            android:id="@+id/releaseLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Release Sink: 0.002" />

        <SeekBar
            android:id="@+id/releaseSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="2" />

        <TextView
            android:id="@+id/hpCutoffLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HP Cutoff (Hz): 80" />

        <SeekBar
            android:id="@+id/hpCutoffSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="500"
            android:progress="80" />

        <TextView
            android:id="@+id/rmsWeightLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RMS Weight: 0.50" />

        <SeekBar
            android:id="@+id/rmsWeightSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/logScaleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log Detection Scale: 12.0" />

        <SeekBar
            android:id="@+id/logScaleSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="300"
            android:progress="120" />

        <TextView
            android:id="@+id/volScaleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volume Scale: 0.20" />

        <SeekBar
            android:id="@+id/volScaleSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="20" />

        <TextView
            android:id="@+id/warmCutoffLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Warm Cutoff Max (Hz): 1500" />

        <SeekBar
            android:id="@+id/warmCutoffSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="4000"
            android:progress="1500" />
    </LinearLayout>
</ScrollView>
